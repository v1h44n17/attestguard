# Written by `npm run deploy`. Copy to .env and fill in to point at an
# existing deployment instead.

NEAR_NETWORK=testnet
# NEAR_RPC_URL=https://test.rpc.fastnear.com

# The deployed envelope contract and the accounts around it.
ENVELOPE_CONTRACT_ID=envelope.your-account.testnet
AGENT_ACCOUNT_ID=agent.your-account.testnet
AGENT_PRIVATE_KEY=ed25519:replace-with-the-agent-account-key
VENDOR_ACCOUNT_ID=vendor.your-account.testnet

# Optional. Enables the "reset window" owner action in the console. The key is
# read from ~/.near-credentials/<network>/<owner>.json unless
# OWNER_PRIVATE_KEY is set.
OWNER_ACCOUNT_ID=your-account.testnet

# 32-byte hex secp256k1 key that signs intents in place of the enclave key.
DEV_SIGNER_PRIVATE_KEY=replace-with-64-hex-characters

# Display scale: yoctoNEAR per demo dollar (default: $1 = 0.000001 NEAR).
YOCTO_PER_USD=1000000000000000000
PORT=8787
