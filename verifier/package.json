{
  "name": "attestguard-verifier",
  "version": "1.0.0",
  "private": true,
  "description": "AttestGuard off-chain attestation verifier, intent signer and demo console server",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "demo": "node --env-file-if-exists=.env src/demo.ts",
    "bench": "node src/bench.ts",
    "attest:live": "node src/live.ts",
    "review": "node --env-file-if-exists=.env src/review-cli.ts",
    "deploy": "node src/deploy.ts",
    "test": "node --test ../tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@near-js/accounts": "1.4.1",
    "@near-js/crypto": "1.4.2",
    "@near-js/keystores": "0.2.2",
    "@near-js/providers": "1.0.3",
    "@near-js/signers": "0.2.2",
    "@near-js/transactions": "1.3.3",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
